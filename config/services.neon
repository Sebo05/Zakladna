extensions:
	nextras.dbal: Nextras\Dbal\Bridges\NetteDI\DbalExtension
	nextras.orm: Nextras\Orm\Bridges\NetteDI\OrmExtension

nextras.dbal:
	driver: mysqli
	host: 127.0.0.1
	username: root
	password: ''
	database: ano
	connectionTz: '+00:00'

nextras.orm:
	model: App\Model\Orm


services:
	- App\Core\RouterFactory::createRouter

	adminAuthenticator:
		factory: App\Security\AdminAuthenticator
		autowired: self

	- App\Model\Notification\Notifier(appUrl: %appUrl%, mailFrom: %mailFrom%, tempDir: %tempDir%)

	- App\Security\GoogleAuth(%google.clientId%, %google.clientSecret%)

	userAuthenticator:
		factory: App\Security\UserAuthenticator
		autowired: self


search:
	-	in: %appDir%
		files:
			- '*Facade.php'
			- '*Factory.php'
			- '*Service.php'


decorator:
	App\Presentation\Frontend\BasePresenter:
		setup:
			- $operator = %operator%
			- $legalDate = %legalDate%
