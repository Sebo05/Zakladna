{import '../@components.latte'}
{block title}Garáž{/block}

{block content}
<header class="flex flex-wrap items-end justify-between gap-4 mb-8 rise">
	<div>
		<h1 class="page-title">Garáž</h1>
		<p class="page-sub">{count($cars)} {count($cars) === 1 ? 'auto' : (count($cars) > 1 && count($cars) < 5 ? 'auta' : 'aut')}</p>
	</div>
	<a n:href="add" class="btn btn-primary"><i data-lucide="plus" class="w-4 h-4"></i>Přidat auto</a>
</header>

{if !$cars}
	<div class="card p-12 text-center rise">
		<span class="tile bg-accent/12 text-accent mx-auto w-14 h-14 rounded-2xl"><i data-lucide="car" class="w-7! h-7!"></i></span>
		<h2 class="section-title mt-4">Garáž je prázdná</h2>
		<p class="text-muted mt-1 mb-6">Přidej auto a hlídej STK, pojištění, servis i spotřebu.</p>
		<a n:href="add" class="btn btn-primary">Přidat první auto</a>
	</div>
{else}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
	<a n:foreach="$cars as $i => $row" n:href="detail $row['car']->id" class="card card-hover overflow-hidden group rise" style="animation-delay: {$i * 60}ms">
		{var $car = $row['car']}
		<div class="aspect-[16/10] bg-surface-2 flex items-center justify-center overflow-hidden">
			{if $car->photo}
				<img src="{$basePath}/www/upload/{$car->photo}" alt="{$car->name}" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-500">
			{else}
				<i data-lucide="car" class="w-14 h-14 text-faint"></i>
			{/if}
		</div>
		<div class="p-5">
			<div class="flex items-start justify-between gap-3">
				<div class="min-w-0">
					<div class="font-semibold text-[17px] tracking-tight truncate">{$car->name}</div>
					<div class="text-sm text-muted mt-0.5"><span class="font-mono">{$car->licensePlate}</span> · {$car->year}</div>
				</div>
				{if $row['nextDoc']}
					{include daysBadge, days: ($row['nextDoc']->expiresAt|daysUntil)}
				{/if}
			</div>
			<div class="grid grid-cols-2 gap-3 mt-4 pt-4 border-t border-line">
				<div>
					<div class="eyebrow">Spotřeba</div>
					<div class="num text-sm font-semibold mt-0.5">{if $row['avgConsumption'] !== null}{$row['avgConsumption']|number:1,',',' '} l/100 km{else}<span class="text-faint font-normal">—</span>{/if}</div>
				</div>
				<div>
					<div class="eyebrow">Servis celkem</div>
					<div class="num text-sm font-semibold mt-0.5">{$row['totalCost']|czk}</div>
				</div>
			</div>
			<div n:if="$row['nextDoc']" class="text-xs text-muted mt-3">
				{$docTypeLabels[$row['nextDoc']->type]} do {$row['nextDoc']->expiresAt|date:'j. n. Y'}
			</div>
		</div>
	</a>
</div>
{/if}
{/block}
