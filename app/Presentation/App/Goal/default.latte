{import '../@components.latte'}
{block title}Cíle{/block}

{block content}
{var $hex = ['blue' => '#0a84ff', 'green' => '#30d158', 'orange' => '#ff9f0a', 'pink' => '#ff375f', 'violet' => '#bf5af2', 'teal' => '#40c8e0']}

<header class="flex flex-wrap items-end justify-between gap-4 mb-8 rise">
	<div>
		<h1 class="page-title">Spořicí cíle</h1>
		<p class="page-sub" n:if="$goals">Naspořeno <span class="num font-medium text-ink">{$totalSaved|czk}</span> z {$totalTarget|czk}</p>
	</div>
	<a n:href="add" class="btn btn-primary"><i data-lucide="plus" class="w-4 h-4"></i>Nový cíl</a>
</header>

{if !$goals}
	<div class="card p-12 text-center rise">
		<span class="tile bg-accent/12 text-accent mx-auto w-14 h-14 rounded-2xl"><i data-lucide="target" class="w-7! h-7!"></i></span>
		<h2 class="section-title mt-4">Na co si šetříš?</h2>
		<p class="text-muted mt-1 mb-6 max-w-md mx-auto">Dovolená, nové auto nebo finanční rezerva. Nastav cíl a termín a Základna ti spočítá, kolik odkládat každý měsíc.</p>
		<a n:href="add" class="btn btn-primary">Vytvořit první cíl</a>
	</div>
{else}
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
	{foreach $goals as $i => $g}
		{var $pct = $g->targetAmount > 0 ? max(0, min(1, $g->saved / $g->targetAmount)) : 0}
		{var $color = $hex[$g->color] ?? $hex['blue']}
		{var $done = $g->saved >= $g->targetAmount}
		{var $monthly = $g->getMonthlyNeeded()}
		<div class="card p-6 flex flex-col group rise" style="animation-delay: {$i * 60}ms" x-data="{ open: false, history: false }">
			<div class="flex items-start gap-4">
				{* Progress ring *}
				<div class="relative w-20 h-20 shrink-0">
					<svg viewBox="0 0 80 80" class="w-20 h-20 -rotate-90">
						<circle cx="40" cy="40" r="34" fill="none" stroke="var(--surface-2)" stroke-width="8"/>
						<circle cx="40" cy="40" r="34" fill="none" stroke="{$color}" stroke-width="8" stroke-linecap="round"
							stroke-dasharray="213.6" stroke-dashoffset="{round(213.6 * (1 - $pct), 1)}" class="transition-all duration-700"/>
					</svg>
					<div class="absolute inset-0 flex items-center justify-center">
						{if $done}
							<i data-lucide="check" class="w-7 h-7" style="color: {$color|noescape}"></i>
						{else}
							<span class="num text-sm font-semibold">{round($pct * 100)} %</span>
						{/if}
					</div>
				</div>
				<div class="min-w-0 flex-1">
					<div class="flex items-start justify-between gap-2">
						<h2 class="font-semibold text-[17px] tracking-tight truncate">{$g->name}</h2>
						<div class="flex -mr-2 -mt-1 opacity-0 group-hover:opacity-100 transition">
							<a n:href="edit $g->id" class="btn-icon" title="Upravit"><i data-lucide="pencil" class="w-4 h-4"></i></a>
							<a n:href="delete $g->id" data-confirm="Smazat cíl včetně historie vkladů?" class="btn-icon danger" title="Smazat"><i data-lucide="trash-2" class="w-4 h-4"></i></a>
						</div>
					</div>
					<div class="num text-xl font-semibold mt-1">{$g->saved|czk}</div>
					<div class="text-sm text-muted">z {$g->targetAmount|czk}</div>
					<div class="flex flex-wrap gap-1.5 mt-2">
						<span n:if="$g->household" class="badge badge-accent"><i data-lucide="house" class="w-3 h-3"></i>Domácnost</span>
						<span n:if="$g->deadline" class="badge badge-muted"><i data-lucide="clock" class="w-3 h-3"></i>{$g->deadline|date:'j. n. Y'}</span>
					</div>
				</div>
			</div>

			<div n:if="!$done && $monthly !== null" class="mt-4 rounded-xl bg-surface-2 px-3.5 py-2.5 text-sm">
				Odkládej <span class="num font-semibold">{$monthly|czk}</span> měsíčně a stihneš to.
			</div>
			<div n:if="$done" class="mt-4 rounded-xl px-3.5 py-2.5 text-sm font-medium" style="background: color-mix(in srgb, {$color|noescape} 14%, transparent); color: {$color|noescape}">
				Splněno! Můžeš slavit.
			</div>

			<div class="mt-auto pt-4">
				<div x-show="!open" class="flex gap-2">
					<button type="button" @click="open = true; $nextTick(() => $refs.amount.focus())" class="btn btn-secondary flex-1"><i data-lucide="plus" class="w-4 h-4"></i>Vložit</button>
					<button n:if="$g->deposits->count()" type="button" @click="history = !history" class="btn btn-secondary" title="Historie"><i data-lucide="clock" class="w-4 h-4"></i></button>
				</div>
				<div x-show="open" x-cloak>
				{form "depositForm-$g->id", class: 'flex gap-2 items-center'}
					{input amount, class: 'input py-2!'}
					<label class="flex items-center gap-1.5 text-xs text-muted whitespace-nowrap cursor-pointer">{input withdraw:} vybrat</label>
					{input send, class: 'btn btn-primary'}
					<button type="button" @click="open = false" class="btn-icon"><i data-lucide="x" class="w-4 h-4"></i></button>
				{/form}
				</div>

				<div x-show="history" x-cloak x-transition class="mt-3 border-t border-line pt-2">
					{foreach $g->deposits as $d}
						{breakIf $iterator->counter > 6}
						<div class="flex items-center gap-2 py-1.5 text-sm group/d">
							<span class="text-muted text-xs w-14">{$d->date|date:'j. n.'}</span>
							<span class="flex-1 truncate text-muted text-xs">{$d->user->name}</span>
							<span n:class="'num font-medium', $d->amount < 0 ? 'text-neg' : 'text-pos'">{$d->amount > 0 ? '+'}{$d->amount|czk}</span>
							<a n:href="deleteDeposit $d->id" data-confirm="Odebrat vklad?" class="btn-icon danger w-6! h-6! opacity-0 group-hover/d:opacity-100"><i data-lucide="x" class="w-3 h-3"></i></a>
						</div>
					{/foreach}
				</div>
			</div>
		</div>
	{/foreach}
</div>
{/if}
{/block}
