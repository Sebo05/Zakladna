{import '../@components.latte'}
{form transactionForm, class: 'space-y-5'}
	{include formErrors, form: $form}
	{* Type as a segmented control (radio buttons styled) *}
	<div class="segmented w-full grid grid-cols-2" x-data="{ t: '{$form['type']->getValue()}' }">
		<label n:foreach="$form['type']->getItems() as $key => $caption" class="text-center cursor-pointer transition py-1.5!" :class="t === '{$key}' ? 'on' : ''">
			<input type="radio" name="type" value="{$key}" class="sr-only" x-model="t"> {$caption}
		</label>
	</div>
	<div class="grid sm:grid-cols-2 gap-4">
		{include field, form: $form, name: 'amount'}
		{include field, form: $form, name: 'date'}
	</div>
	{include field, form: $form, name: 'description'}
	<div class="grid sm:grid-cols-2 gap-4">
		{include field, form: $form, name: 'category'}
		{include field, form: $form, name: 'car'}
	</div>
	<datalist id="categories"><option n:foreach="$categories ?? [] as $c" value="{$c}"></option></datalist>
	<div class="pt-2">{input send, class: 'btn btn-primary btn-lg'}</div>
{/form}
