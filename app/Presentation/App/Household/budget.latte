{import '../@components.latte'}
{block title}Rozpočet domácnosti{/block}

{block content}
{include '@nav.latte'}

<div class="grid lg:grid-cols-3 gap-5">
	<div class="lg:col-span-2 space-y-5">
		{if $rows}
			<div class="grid sm:grid-cols-2 gap-5">
				{foreach $rows as $i => $r}
					{var $over = $r['pct'] > 100}
					{var $left = $r['budget']->monthlyLimit - $r['spent']}
					<div class="card p-5 group rise" style="animation-delay: {$i * 50 + 100}ms">
						<div class="flex items-start justify-between gap-2">
							<div class="flex items-center gap-3 min-w-0">
								<span n:class="'tile', $over ? 'bg-neg/12 text-neg' : 'bg-accent/12 text-accent'"><i data-lucide="target"></i></span>
								<div class="font-semibold truncate">{$r['budget']->category}</div>
							</div>
							<a n:href="deleteBudget $r['budget']->id" data-confirm="Smazat rozpočet?" class="btn-icon danger opacity-0 group-hover:opacity-100" title="Smazat"><i data-lucide="trash-2" class="w-4 h-4"></i></a>
						</div>
						<div class="num text-2xl font-semibold mt-4">{$r['spent']|czk}</div>
						<div class="text-sm text-muted">z {$r['budget']->monthlyLimit|czk}</div>
						<div class="relative mt-4">
							<div class="progress"><span n:class="$over ? 'bg-neg' : ($r['pct'] > $monthProgress ? 'bg-warn' : 'bg-pos')" style="width: {round(min(100, $r['pct']))}%"></span></div>
							<div class="absolute -top-1 h-3.5 w-0.5 bg-ink/40 rounded" style="left: {round($monthProgress)}%" title="Dnešní den v měsíci"></div>
						</div>
						<div n:class="'text-xs mt-2 font-medium', $over ? 'text-neg' : 'text-muted'">
							{if $over}Přečerpáno o {-$left|czk}{else}Zbývá {$left|czk} · {round($r['pct'])} %{/if}
						</div>
					</div>
				{/foreach}
			</div>
		{else}
			<div class="card p-10 text-center rise rise-2">
				<span class="tile bg-accent/12 text-accent mx-auto w-14 h-14 rounded-2xl"><i data-lucide="piggy-bank" class="w-7! h-7!"></i></span>
				<h2 class="section-title mt-4">Společný rozpočet</h2>
				<p class="text-muted mt-1 max-w-md mx-auto">Nastavte měsíční limity pro společné výdaje, třeba nákupy nebo energie.</p>
			</div>
		{/if}

		<section n:if="$unbudgeted" class="card px-6 py-2 rise rise-3">
			<h2 class="section-title pt-4 pb-1">Výdaje bez rozpočtu</h2>
			<div n:foreach="$unbudgeted as $cat => $sum" class="list-row">
				<span class="tile bg-surface-2 text-muted"><i data-lucide="tag"></i></span>
				<div class="flex-1 font-medium text-sm">{$cat}</div>
				<div class="num text-sm">{$sum|czk}</div>
			</div>
		</section>
	</div>

	<section class="card p-6 self-start rise rise-2">
		<h2 class="section-title mb-1">Nastavit limit</h2>
		<p class="text-xs text-muted mb-4">Stejná kategorie přepíše existující limit.</p>
		{form budgetForm, class: 'space-y-4'}
			{include formErrors, form: $form}
			{include field, form: $form, name: 'category'}
			{include field, form: $form, name: 'monthlyLimit'}
			<datalist id="hh-categories">
				<option n:foreach="array_keys($unbudgeted) as $c" value="{$c}"></option>
				<option n:foreach="$rows as $r" value="{$r['budget']->category}"></option>
			</datalist>
			{input send, class: 'btn btn-primary w-full'}
		{/form}
	</section>
</div>
{/block}
