{import '../@components.latte'}
{block title}Kalendář{/block}

{block content}
<header class="flex flex-wrap items-end justify-between gap-4 mb-8 rise">
	<div>
		<h1 class="page-title">Kalendář</h1>
		<div class="flex items-center gap-1 mt-2">
			<a n:href="default, month: $prevMonth" class="btn-icon" title="Předchozí měsíc"><i data-lucide="chevron-left" class="w-5 h-5"></i></a>
			<span class="text-[15px] font-medium min-w-32 text-center first-letter:uppercase">{$monthLabel|czMonth} {$monthLabel|date:'Y'}</span>
			<a n:href="default, month: $nextMonth" class="btn-icon" title="Další měsíc"><i data-lucide="chevron-right" class="w-5 h-5"></i></a>
			<a n:href="default, month: null" class="btn btn-ghost text-sm ml-1">Dnes</a>
		</div>
	</div>
	<a n:href="add" class="btn btn-primary"><i data-lucide="plus" class="w-4 h-4"></i>Nová událost</a>
</header>

<section class="card overflow-hidden mb-6 rise rise-2">
	<div class="grid grid-cols-7 text-xs font-medium text-muted border-b border-line">
		<div n:foreach="['Po', 'Út', 'St', 'Čt', 'Pá', 'So', 'Ne'] as $d" class="px-2 py-3 text-center">{$d}</div>
	</div>
	<div class="grid grid-cols-7">
		<div n:foreach="$days as $i => $day"
			n:class="'calendar-day min-h-16 sm:min-h-28 p-1 sm:p-1.5 border-line', ($i + 1) % 7 ? 'border-r', $i < 35 ? 'border-b', !$day['inMonth'] ? 'out-of-month', $day['isToday'] ? 'is-today'">
			<div class="flex justify-center sm:justify-start mb-1">
				<span class="day-num text-xs sm:text-sm w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center num">{$day['date']|date:'j'}</span>
			</div>
			{* Desktop: event chips. Mobile: dots *}
			<div class="hidden sm:block space-y-1">
				{foreach $day['events'] as $e}
					{if $e['kind'] === 'manual'}
						<a n:href="edit $e[id]" class="block text-xs px-1.5 py-0.5 rounded-md truncate bg-accent/12 text-accent hover:bg-accent/20" title="{$e['title']}">{$e['title']}</a>
					{else}
						<div class="text-xs px-1.5 py-0.5 rounded-md truncate bg-orange-500/12 text-orange-500" title="{$e['title']}">{$e['title']}</div>
					{/if}
				{/foreach}
			</div>
			<div class="sm:hidden flex justify-center gap-0.5">
				<span n:foreach="$day['events'] as $e" n:class="'w-1.5 h-1.5 rounded-full', $e['kind'] === 'manual' ? 'bg-accent' : 'bg-orange-500'"></span>
			</div>
		</div>
	</div>
</section>

<section class="card p-6 rise rise-3">
	<h2 class="section-title mb-2">Příštích 30 dní</h2>
	{if !$upcoming}
		<p class="text-sm text-muted py-6 text-center">Nic na obzoru.</p>
	{else}
		<div>
			<div n:foreach="$upcoming as $e" class="list-row group">
				<span n:class="'tile flex-col leading-none', $e['kind'] === 'garage' ? 'bg-orange-500/12 text-orange-500' : 'bg-accent/12 text-accent'">
					<span class="text-[9px] uppercase font-semibold opacity-70">{$e['date']|czShortDate|substr:0,2}</span>
					<span class="text-sm font-semibold">{$e['date']|date:'j'}</span>
				</span>
				<div class="flex-1 min-w-0">
					<div class="text-sm font-medium truncate">{$e['title']}</div>
					<div n:if="$e['description']" class="text-xs text-muted truncate">{$e['description']}</div>
				</div>
				{if $e['kind'] === 'garage'}
					<span class="badge badge-warn"><i data-lucide="car" class="w-3 h-3"></i>Garáž</span>
				{else}
					<div class="flex sm:opacity-0 group-hover:opacity-100 transition">
						<a n:href="edit $e[id]" class="btn-icon" title="Upravit"><i data-lucide="pencil" class="w-4 h-4"></i></a>
						<a n:href="delete $e[id]" data-confirm="Smazat událost?" class="btn-icon danger" title="Smazat"><i data-lucide="trash-2" class="w-4 h-4"></i></a>
					</div>
				{/if}
			</div>
		</div>
	{/if}
</section>
{/block}
