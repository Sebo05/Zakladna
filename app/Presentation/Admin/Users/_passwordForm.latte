{form $formName, class: 'space-y-5'}
	<div n:foreach="$form->getOwnErrors() as $e" class="form-error">{$e}</div>
	<div n:foreach="['password', 'passwordConfirm'] as $f">
		{label $f, class: 'label'/}
		{input $f, class: 'input'}
		<p n:foreach="$form[$f]->getErrors() as $e" class="form-error mt-1.5">{$e}</p>
	</div>
	{input send, class: 'btn btn-primary'}
{/form}
