<h1 class="page-title">Změna hesla</h1>
<p class="page-sub mb-6">Uživatel {$detailUser->name} · {$detailUser->email}</p>
<div class="card p-6 max-w-md rise">
	{include _passwordForm.latte, formName: 'userPasswordForm'}
</div>
{/block}
