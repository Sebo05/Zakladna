{block title}Přehled{/block}

{define kpi, string $label, $value, string $icon, string $tone, ?string $sub = null, ?string $href = null}
	<a href="{$href ?? '#'}" n:class="'card p-5 flex flex-col gap-3', $href ? 'card-hover'">
		<span class="tile {$tone}"><i data-lucide="{$icon}"></i></span>
		<div>
			<div class="num text-3xl font-semibold tracking-tight">{$value}</div>
			<div class="text-sm text-muted mt-0.5">{$label}</div>
			<div n:if="$sub" class="text-xs text-faint mt-1">{$sub}</div>
		</div>
	</a>
{/define}

{block content}
<header class="flex flex-wrap items-end justify-between gap-4 mb-8 rise">
	<div>
		<div class="eyebrow">Administrace</div>
		<h1 class="page-title mt-1">Jak se Základna používá</h1>
		<p class="page-sub">Souhrnné počty napříč všemi uživateli. Žádné finanční údaje ani obsah záznamů.</p>
	</div>
	<a n:href="Users:default" class="btn btn-secondary"><i data-lucide="user" class="w-4 h-4"></i>Uživatelé</a>
</header>

{* KPIs *}
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-5 rise rise-2">
	{include kpi, label: 'Uživatelů', value: $kpi['users'], icon: 'user', tone: 'bg-accent/12 text-accent', sub: '+' . $kpi['newWeek'] . ' za 7 dní · +' . $kpi['newMonth'] . ' za 30 dní', href: $presenter->link('Users:default')}
	{include kpi, label: 'Domácností', value: $kpi['households'], icon: 'house-plus', tone: 'bg-orange-500/12 text-orange-500', sub: 'Ø ' . number_format($kpi['avgMembers'], 1, ',', ' ') . ' člena', href: $presenter->link('Households:default')}
	{include kpi, label: 'Aut v garážích', value: $kpi['cars'], icon: 'car', tone: 'bg-sky-500/12 text-sky-500', sub: $kpi['fuel'] . ' tankování'}
	{include kpi, label: 'Transakcí', value: number_format($kpi['transactions'], 0, ',', ' '), icon: 'wallet', tone: 'bg-pos/12 text-pos', sub: $kpi['monthTransactions'] . ' tento měsíc'}
	{include kpi, label: 'Spořicích cílů', value: $kpi['goals'], icon: 'target', tone: 'bg-violet-500/12 text-violet-500', sub: $kpi['householdGoals'] . ' společných'}
	{include kpi, label: 'Událostí v kalendáři', value: $kpi['events'], icon: 'calendar', tone: 'bg-pink-500/12 text-pink-500'}
	{include kpi, label: 'Vlastní přehled', value: $kpi['customised'], icon: 'sliders-horizontal', tone: 'bg-surface-2 text-muted', sub: 'uživatelů si upravilo dashboard'}
	{include kpi, label: 'Obsah webu', value: $pagesCount, icon: 'file-text', tone: 'bg-surface-2 text-muted', sub: $menuCount . ' položek menu', href: $presenter->link('Pages:default')}
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
	{* Registrations *}
	<section class="card p-6 lg:col-span-2 rise rise-3">
		<div class="flex items-center justify-between mb-4">
			<h2 class="section-title">Registrace · posledních 30 dní</h2>
			<span class="badge badge-accent">+{$kpi['newMonth']}</span>
		</div>
		<div class="h-56">
			<canvas data-chart="bar" data-chart-config="registrations"></canvas>
		</div>
		<script type="application/json" id="chart-registrations">{$registrationsChart|noescape}</script>
		<script type="application/json" id="chart-registrations-opts">{$chartOptions|noescape}</script>
	</section>

	{* Feature adoption *}
	<section class="card p-6 lg:row-span-2 rise rise-3">
		<h2 class="section-title">Co lidé používají</h2>
		<p class="text-xs text-muted mt-0.5 mb-4">Podíl uživatelů s aspoň jedním záznamem</p>
		<div class="space-y-4">
			<div n:foreach="$adoption as $a">
				<div class="flex items-center gap-2 text-sm mb-1.5">
					<i data-lucide="{$a['icon']}" class="w-4 h-4 text-muted"></i>
					<span class="font-medium flex-1">{$a['label']}</span>
					<span class="num text-muted">{$a['users']} · {round($a['pct'])} %</span>
				</div>
				<div class="progress"><span class="bg-accent" style="width: {round(min(100, $a['pct']))}%"></span></div>
			</div>
		</div>
	</section>

	{* Weekly activity *}
	<section class="card p-6 lg:col-span-2 rise rise-4">
		<h2 class="section-title mb-4">Aktivita po týdnech</h2>
		<div class="h-64">
			<canvas data-chart="bar" data-chart-config="activity"></canvas>
		</div>
		<script type="application/json" id="chart-activity">{$activityChart|noescape}</script>
		<script type="application/json" id="chart-activity-opts">{$stackedOptions|noescape}</script>
	</section>

	{* Recent registrations *}
	<section class="card p-6 lg:col-span-2 rise rise-4">
		<div class="flex items-center justify-between mb-2">
			<h2 class="section-title">Nově registrovaní</h2>
			<a n:href="Users:default" class="btn btn-ghost text-sm">Všichni <i data-lucide="chevron-right" class="w-4 h-4"></i></a>
		</div>
		<div class="grid sm:grid-cols-2 gap-x-6">
			<a n:foreach="$recentUsers as $u" n:href="Users:userDetail $u->id" class="list-row group">
				<span class="w-9 h-9 rounded-full bg-linear-to-br from-sky-400 to-indigo-500 text-white text-sm font-semibold flex items-center justify-center shrink-0">{$u->name|substr:0,1|upper}</span>
				<div class="flex-1 min-w-0">
					<div class="text-sm font-medium truncate group-hover:text-accent">{$u->name}</div>
					<div class="text-xs text-muted truncate">{$u->email}</div>
				</div>
				<span class="text-xs text-muted whitespace-nowrap">{$u->createdAt|date:'j. n. Y'}</span>
			</a>
		</div>
	</section>

	{* Data health *}
	<section class="card p-6 rise rise-4">
		<h2 class="section-title mb-2">Stav dat</h2>
		<div class="list-row">
			<span n:class="'tile', $inactiveUsers ? 'bg-warn/15 text-warn' : 'bg-pos/12 text-pos'"><i data-lucide="user-minus"></i></span>
			<div class="flex-1 text-sm">Účty bez jakýchkoliv dat</div>
			<span class="num font-semibold">{$inactiveUsers}</span>
		</div>
		<div class="list-row">
			<span n:class="'tile', $soloHouseholds ? 'bg-warn/15 text-warn' : 'bg-pos/12 text-pos'"><i data-lucide="house-plus"></i></span>
			<div class="flex-1 text-sm">Domácnosti s jediným členem</div>
			<span class="num font-semibold">{$soloHouseholds}</span>
		</div>
		<div class="list-row">
			<span n:class="'tile', $expiredDocs ? 'bg-neg/12 text-neg' : 'bg-pos/12 text-pos'"><i data-lucide="circle-alert"></i></span>
			<div class="flex-1 text-sm">Propadlé dokumenty (STK, pojištění…)</div>
			<span class="num font-semibold">{$expiredDocs}</span>
		</div>
	</section>
</div>
{/block}
