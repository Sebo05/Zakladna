{block title}Domácnosti{/block}

{block content}
<header class="mb-6 rise">
	<div class="eyebrow">Administrace</div>
	<h1 class="page-title mt-1">Domácnosti</h1>
	<p class="page-sub">{count($households)} sdílených domácností · jen počty, bez částek a obsahu</p>
</header>

<div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4 rise rise-2">
	<a n:foreach="$households as $h" n:href="detail $h->id" class="card card-hover p-5 flex flex-col">
		<div class="flex items-start gap-3">
			<span class="tile bg-orange-500/12 text-orange-500"><i data-lucide="house-plus"></i></span>
			<div class="min-w-0 flex-1">
				<div class="font-semibold tracking-tight truncate">{$h->name}</div>
				<div class="text-xs text-muted">správce {$h->owner_name} · od {$h->created_at|date:'j. n. Y'}</div>
			</div>
			<span n:class="'badge', $h->members <= 1 ? 'text-warn'">{$h->members} {$h->members == 1 ? 'člen' : ($h->members < 5 ? 'členové' : 'členů')}</span>
		</div>
		<p class="text-sm text-muted mt-3 truncate">{$h->member_names}</p>
		<div class="grid grid-cols-4 gap-2 mt-4 pt-4 border-t border-line text-center">
			<div><div class="num font-semibold">{$h->expenses}</div><div class="text-xs text-muted">výdajů</div></div>
			<div><div class="num font-semibold">{$h->tasks}</div><div class="text-xs text-muted">úkolů</div></div>
			<div><div class="num font-semibold">{$h->shopping}</div><div class="text-xs text-muted">nákupů</div></div>
			<div><div class="num font-semibold">{$h->goals}</div><div class="text-xs text-muted">cílů</div></div>
		</div>
	</a>
</div>
<div n:if="!$households" class="card p-10 text-center text-muted">Zatím žádná domácnost.</div>
{/block}
