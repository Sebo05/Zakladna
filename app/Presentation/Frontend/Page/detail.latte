{block title}{$page->title}{/block}

{block content}
<article class="max-w-3xl mx-auto px-5 py-16 rise">
	<a n:href="Home:default" class="inline-flex items-center gap-1 text-sm text-accent hover:underline"><i data-lucide="chevron-left" class="w-4 h-4"></i>Domů</a>
	<h1 class="text-4xl sm:text-5xl font-bold tracking-tight mt-4 mb-10">{$page->title}</h1>
	<div class="prose max-w-none">
		{$page->content|noescape}
	</div>
</article>
{/block}
