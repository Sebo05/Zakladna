{* Auth form field: leading icon, live "valid" check, server errors. Rule: email | filled | min6 | match (= same as password). *}
{define authField, $form, string $name, string $icon, string $rule = 'filled', bool $toggle = false}
	{var $err = $form[$name]->hasErrors()}
	<div x-data="{ ok: false }" data-rule="{$rule}" @input="ok = authValid($event.target, $el.dataset.rule)">
		{label $name, class: 'label' /}
		<div class="relative">
			<i data-lucide="{$icon}" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-faint pointer-events-none"></i>
			{input $name, class: ($err ? 'input pl-10 pr-20 border-neg!' : 'input pl-10 pr-20')}
			<span x-show="ok" x-cloak x-transition.scale.80 n:class="'absolute top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-pos text-white flex items-center justify-center pointer-events-none', $toggle ? 'right-11' : 'right-3'">
				<i data-lucide="check" class="w-3 h-3"></i>
			</span>
			<button n:if="$toggle" type="button" @click="show = !show" class="absolute right-1.5 top-1/2 -translate-y-1/2 btn-icon" :title="show ? 'Skrýt heslo' : 'Zobrazit heslo'">
				<i data-lucide="eye" class="w-4 h-4" x-show="!show"></i>
				<i data-lucide="eye-off" class="w-4 h-4" x-show="show" x-cloak></i>
			</button>
		</div>
		<p n:foreach="$form[$name]->getErrors() as $e" class="form-error mt-1.5 flex items-center gap-1"><i data-lucide="circle-alert" class="w-3.5 h-3.5 shrink-0"></i>{$e}</p>
	</div>
{/define}

{define submitButton, $form, string $busyText}
	<button n:name="send" class="btn btn-primary btn-lg w-full mt-2 disabled:opacity-70" :disabled="busy">
		<svg x-show="busy" x-cloak class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity=".3" stroke-width="3"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
		<span x-show="!busy">{$form['send']->getCaption()}</span>
		<span x-show="busy" x-cloak>{$busyText}</span>
		<i data-lucide="arrow-right" class="w-4 h-4" x-show="!busy"></i>
	</button>
{/define}
