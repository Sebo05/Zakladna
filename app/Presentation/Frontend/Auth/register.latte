{block title}Registrace{/block}

{block content}
{embed '@auth.latte'}
	{block form}
		<h1 class="text-[2rem] leading-tight font-bold tracking-[-0.025em]">Založ si Základnu</h1>
		<p class="page-sub mb-8">Zdarma a bez reklam. Zabere to minutu.</p>
		{include @google.latte}

		<div x-data="{ p: '', p2: '', show: false, busy: false }" @submit="setTimeout(() => busy = !$event.defaultPrevented)">
			{form registerForm, class: 'space-y-4', novalidate: true}
				<div n:ifcontent class="rounded-xl px-4 py-3 text-sm bg-neg/10 text-neg flex items-center gap-2">
					{foreach $form->getOwnErrors() as $error}<i data-lucide="circle-alert" class="w-4 h-4 shrink-0"></i>{$error}{/foreach}
				</div>
				{include authField, form: $form, name: 'name', icon: 'user'}
				{include authField, form: $form, name: 'email', icon: 'mail', rule: 'email'}
				<div>
					{include authField, form: $form, name: 'password', icon: 'lock', rule: 'min6', toggle: true}
					{* Strength meter *}
					<div x-show="p.length" x-cloak x-transition>
						<div class="flex gap-1 mt-2">
							<template x-for="i in 4"><span class="h-1 flex-1 rounded-full transition-colors duration-300"
								:class="i <= passwordScore(p) ? ['bg-neg', 'bg-warn', 'bg-accent', 'bg-pos'][passwordScore(p) - 1] : 'bg-surface-2'"></span></template>
						</div>
						<p class="text-xs text-muted mt-1.5" x-text="['Příliš krátké (aspoň 6 znaků)', 'Slabé heslo', 'Ujde', 'Dobré heslo', 'Silné heslo'][passwordScore(p)]"></p>
					</div>
				</div>
				{include authField, form: $form, name: 'passwordConfirm', icon: 'lock', rule: 'match'}
				<p x-show="p2.length && p !== p2" x-cloak class="form-error -mt-2">Hesla se zatím neshodují.</p>
				{include submitButton, form: $form, busyText: 'Zakládám účet…'}
				<p class="text-xs text-muted text-center leading-relaxed">Registrací souhlasíš s <a n:href="Legal:terms" target="_blank" class="text-accent hover:underline">podmínkami používání</a> a bereš na vědomí <a n:href="Legal:privacy" target="_blank" class="text-accent hover:underline">zásady ochrany osobních údajů</a>. Data neprodáváme ani nesdílíme.</p>
			{/form}
		</div>

		<p class="text-sm text-muted text-center mt-8">
			Už máš účet? <a n:href="login" class="text-accent font-medium hover:underline">Přihlas se</a>
		</p>
	{/block}
{/embed}
{/block}
