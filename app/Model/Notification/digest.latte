<!doctype html>
<html lang="cs">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"></head>
<body style="margin:0;background:#f5f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Roboto,sans-serif;color:#1d1d1f">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 16px">
<tr><td align="center">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px">
		<tr><td style="padding:0 4px 20px">
			<table role="presentation" cellpadding="0" cellspacing="0"><tr>
				<td style="width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#38bdf8,#3b82f6 50%,#4f46e5);color:#fff;font-weight:700;text-align:center;font-size:15px">Z</td>
				<td style="padding-left:10px;font-weight:600;font-size:16px">Základna</td>
			</tr></table>
		</td></tr>
		<tr><td style="background:#fff;border-radius:20px;padding:28px 28px 8px;box-shadow:0 1px 3px rgba(0,0,0,.06)">
			<h1 style="margin:0 0 6px;font-size:22px;letter-spacing:-.02em">Ahoj {$user->name},</h1>
			<p style="margin:0 0 20px;color:#6e6e73;font-size:15px">tohle se ti blíží:</p>
			<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
				<tr n:foreach="$items as $i">
					<td style="padding:12px 0;border-top:1px solid #e8e8ed;width:36px;font-size:22px">{$i['icon']}</td>
					<td style="padding:12px 0;border-top:1px solid #e8e8ed">
						<div style="font-weight:600;font-size:15px">{$i['title']}</div>
						<div style="color:#6e6e73;font-size:13px;margin-top:2px">{$i['when']}</div>
					</td>
					<td align="right" style="padding:12px 0;border-top:1px solid #e8e8ed;white-space:nowrap">
						<span style="display:inline-block;padding:4px 10px;border-radius:99px;font-size:12px;font-weight:600;{if $i['days'] <= 1}background:#ffe5e3;color:#d70015{elseif $i['days'] <= 7}background:#fff3d6;color:#a05a00{else}background:#e8f1ff;color:#0062cc{/if}">
							{if $i['days'] <= 0}dnes{elseif $i['days'] === 1}zítra{else}za {$i['days']} dní{/if}
						</span>
					</td>
				</tr>
			</table>
			<p style="margin:24px 0">
				<a href="{$appUrl}/app/" style="display:inline-block;background:#0071e3;color:#fff;text-decoration:none;font-weight:600;padding:12px 22px;border-radius:99px;font-size:15px">Otevřít Základnu</a>
			</p>
		</td></tr>
		<tr><td style="padding:16px 4px;color:#86868b;font-size:12px">
			Upozornění můžeš vypnout v <a href="{$appUrl}/app/profile/" style="color:#86868b">nastavení profilu</a>.
		</td></tr>
	</table>
</td></tr>
</table>
</body>
</html>
