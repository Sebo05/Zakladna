{block title}Změna hesla · {$admin->name}{/block}

{block content}
<a n:href="adminDetail $admin->id" class="btn btn-ghost -ml-3 mb-3 text-sm"><i data-lucide="chevron-left" class="w-4 h-4"></i>{$admin->name}</a>
<h1 class="page-title">Změna hesla</h1>
<p class="page-sub mb-6">Administrátor {$admin->name} · {$admin->email}</p>
<div class="card p-6 max-w-md rise">
	{include _passwordForm.latte, formName: 'adminPasswordForm'}
</div>
{/block}
