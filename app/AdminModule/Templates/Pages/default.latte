{block title}Stránky{/block}

{block content}
<header class="flex flex-wrap items-end justify-between gap-4 mb-6 rise">
	<div>
		<div class="eyebrow">Obsah webu</div>
		<h1 class="page-title mt-1">Stránky</h1>
	</div>
	<a n:href="add" class="btn btn-primary"><i data-lucide="plus" class="w-4 h-4"></i>Nová stránka</a>
</header>

<div class="card p-2 sm:p-4 rise rise-2">
	<div n:foreach="$pages as $page" class="list-row px-3">
		<span class="tile bg-surface-2 text-muted"><i data-lucide="file-text"></i></span>
		<div class="flex-1 min-w-0">
			<a n:href="edit $page->id" class="block text-sm font-medium truncate hover:text-accent">{$page->title}</a>
			<div class="text-xs text-muted font-mono truncate">/{$page->slug}</div>
		</div>
		<span n:class="'badge', $page->visible ? 'badge-accent'">{$page->visible ? 'Viditelná' : 'Skrytá'}</span>
		<a n:href="edit $page->id" class="btn-icon" title="Upravit"><i data-lucide="pencil" class="w-4 h-4"></i></a>
		<a n:href="delete $page->id" class="btn-icon hover:text-neg" title="Smazat" data-confirm="Smazat stránku {$page->title}?"><i data-lucide="trash-2" class="w-4 h-4"></i></a>
	</div>
	<p n:if="!$pages->countStored()" class="text-sm text-muted text-center py-10">Žádné stránky.</p>
</div>
{/block}
