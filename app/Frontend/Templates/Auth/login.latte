{block title}Přihlášení{/block}

{block content}
{embed '@auth.latte'}
	{block form}
		<h1 class="text-[2rem] leading-tight font-bold tracking-[-0.025em]">Vítej zpátky</h1>
		<p class="page-sub mb-8">Přihlas se ke své Základně.</p>

		<div x-data="{ show: false, busy: false }" @submit="setTimeout(() => busy = !$event.defaultPrevented)">
			{form loginForm, class: 'space-y-4', novalidate: true}
				<div n:ifcontent class="rounded-xl px-4 py-3 text-sm bg-neg/10 text-neg flex items-center gap-2">
					{foreach $form->getOwnErrors() as $error}<i data-lucide="circle-alert" class="w-4 h-4 shrink-0"></i>{$error}{/foreach}
				</div>
				{include authField, form: $form, name: 'email', icon: 'mail', rule: 'email'}
				{include authField, form: $form, name: 'password', icon: 'lock', toggle: true}
				<label class="flex items-center gap-2.5 text-sm cursor-pointer select-none w-fit">
					{input remember:, class: 'w-4 h-4 rounded accent-[var(--accent)]'}
					Zapamatovat si mě
				</label>
				{include submitButton, form: $form, busyText: 'Přihlašuji…'}
			{/form}
		</div>

		<div class="flex items-center gap-3 my-8 text-xs text-faint"><span class="h-px flex-1 bg-line"></span>nebo<span class="h-px flex-1 bg-line"></span></div>
		<a n:href="register" class="btn btn-secondary btn-lg w-full">Vytvořit nový účet</a>
	{/block}
{/embed}
{/block}
