{* Split-screen shell for login/register. Child sets {block form}. *}
{import '@field.latte'}
<style>
	@keyframes auth-drift { 0%, 100% { transform: translate(0, 0) scale(1); } 33% { transform: translate(6%, -4%) scale(1.08); } 66% { transform: translate(-5%, 5%) scale(0.95); } }
	@keyframes auth-float { 0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)); } 50% { transform: translateY(-10px) rotate(var(--r, 0deg)); } }
	.auth-blob { animation: auth-drift 18s ease-in-out infinite; }
	.auth-float { animation: auth-float 7s ease-in-out infinite; }
	@media (prefers-reduced-motion: reduce) { .auth-blob, .auth-float { animation: none; } }
</style>
<script>
	// live validity for auth fields (see @field.latte)
	window.authValid = function (el, rule) {
		var v = el.value.trim();
		if (!v) return false;
		if (rule === 'email') return el.checkValidity() && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);
		if (rule === 'min6') return el.value.length >= 6;
		if (rule === 'match') return el.form.password && el.value === el.form.password.value;
		return true;
	};
</script>

<div class="min-h-screen grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] bg-surface">
	{* ---------- Form side ---------- *}
	<div class="relative flex flex-col px-6 py-6 sm:px-12 sm:py-8 overflow-hidden">
		{* soft aurora behind the form on mobile only *}
		<div class="lg:hidden absolute -top-40 -right-32 w-96 h-96 rounded-full bg-sky-400/20 blur-3xl auth-blob pointer-events-none"></div>
		<div class="relative flex items-center justify-between">
			<a n:href="Home:default" class="flex items-center gap-2.5">
				{include '../@logo.latte'}
				<span class="text-[17px] font-semibold tracking-tight">Základna</span>
			</a>
			<button type="button" onclick="toggleTheme()" class="btn-icon" title="Přepnout režim">
				<i data-lucide="moon" class="w-4 h-4 dark:hidden!"></i><i data-lucide="sun" class="w-4 h-4 hidden! dark:block!"></i>
			</button>
		</div>
		<div class="relative flex-1 flex items-center justify-center py-10">
			<div class="w-full max-w-sm rise">
				{include form}
			</div>
		</div>
		<div class="relative flex flex-wrap items-center justify-between gap-2 text-xs text-faint">
			<span>© {date('Y')} Základna</span>
			<span class="flex items-center gap-1.5"><i data-lucide="lock" class="w-3.5 h-3.5"></i>Šifrované spojení, hesla hashovaná</span>
		</div>
	</div>

	{* ---------- Showcase panel ---------- *}
	<div class="hidden lg:block p-3">
		<div class="relative h-full rounded-[2rem] overflow-hidden bg-[#0b1530] text-white flex items-center justify-center p-12">
			<div class="auth-blob absolute -top-24 -left-24 w-[34rem] h-[34rem] rounded-full bg-sky-500/50 blur-[90px]"></div>
			<div class="auth-blob absolute -bottom-32 -right-20 w-[30rem] h-[30rem] rounded-full bg-indigo-600/60 blur-[90px]" style="animation-delay: -6s"></div>
			<div class="auth-blob absolute top-1/3 right-1/4 w-72 h-72 rounded-full bg-fuchsia-500/25 blur-[80px]" style="animation-delay: -11s"></div>
			<div class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(circle_at_1px_1px,white_1px,transparent_0)] bg-[length:22px_22px]"></div>

			<div class="relative w-full max-w-lg">
				<div class="text-sm font-medium text-sky-200/90 flex items-center gap-2"><i data-lucide="sparkles" class="w-4 h-4"></i>Tvoje osobní základna</div>
				<h2 class="text-[2.75rem] font-bold tracking-[-0.03em] leading-[1.05] mt-3">Auta, peníze a termíny.<br><span class="text-white/60">Konečně v klidu.</span></h2>

				{* Floating glass cards *}
				<div class="relative h-[22rem] mt-10">
					<div class="auth-float absolute left-0 top-0 w-64 rounded-3xl bg-white/12 backdrop-blur-xl border border-white/15 p-5 shadow-2xl" style="--r: -2deg">
						<div class="text-xs text-white/60">Zůstatek · říjen</div>
						<div class="text-3xl font-semibold mt-1 num">+28 175 Kč</div>
						<div class="h-1.5 rounded-full bg-white/10 mt-4 flex overflow-hidden"><span class="bg-emerald-400 w-[69%]"></span><span class="bg-rose-400 flex-1"></span></div>
						<div class="flex justify-between text-[11px] text-white/60 mt-2 num"><span>↓ 52 000</span><span>↑ 23 825</span></div>
					</div>

					<div class="auth-float absolute right-0 top-6 w-60 rounded-3xl bg-white/12 backdrop-blur-xl border border-white/15 p-4 shadow-2xl" style="--r: 2deg; animation-delay: -2s">
						<div class="flex items-center gap-3">
							<span class="w-9 h-9 rounded-xl bg-amber-400/25 text-amber-200 flex items-center justify-center"><i data-lucide="bell" class="w-4 h-4"></i></span>
							<div class="flex-1 min-w-0"><div class="text-sm font-medium">STK · Octavia</div><div class="text-[11px] text-white/60">26. 10. 2026</div></div>
							<span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-300 text-amber-950 font-semibold">9 dní</span>
						</div>
					</div>

					<div class="auth-float absolute left-10 bottom-0 w-56 rounded-3xl bg-white/12 backdrop-blur-xl border border-white/15 p-4 shadow-2xl flex items-center gap-4" style="--r: 1deg; animation-delay: -4s">
						<svg viewBox="0 0 48 48" class="w-14 h-14 -rotate-90 shrink-0"><circle cx="24" cy="24" r="19" fill="none" stroke="rgb(255 255 255 / .15)" stroke-width="6"/><circle cx="24" cy="24" r="19" fill="none" stroke="#34d399" stroke-width="6" stroke-linecap="round" stroke-dasharray="119.4" stroke-dashoffset="38"/></svg>
						<div><div class="text-sm font-medium">Dovolená</div><div class="text-[11px] text-white/60 num">32 400 / 48 000 Kč</div></div>
					</div>

					<div class="auth-float absolute right-4 bottom-10 w-60 rounded-3xl bg-white/12 backdrop-blur-xl border border-white/15 p-4 shadow-2xl" style="--r: -1.5deg; animation-delay: -5s">
						<div class="flex items-center gap-2 text-[11px] text-white/60"><i data-lucide="house-plus" class="w-3.5 h-3.5"></i>Domácnost</div>
						<div class="flex items-center gap-2 mt-2 text-sm">
							<span class="w-6 h-6 rounded-full bg-linear-to-br from-pink-400 to-rose-500 text-[11px] font-semibold flex items-center justify-center">P</span>
							<i data-lucide="arrow-right" class="w-3.5 h-3.5 text-white/50"></i>
							<span class="w-6 h-6 rounded-full bg-linear-to-br from-sky-400 to-indigo-500 text-[11px] font-semibold flex items-center justify-center">T</span>
							<span class="ml-auto font-semibold num">420 Kč</span>
						</div>
					</div>
				</div>

				<div class="flex flex-wrap gap-x-6 gap-y-2 mt-10 text-sm text-white/70">
					<span class="flex items-center gap-2"><i data-lucide="fuel" class="w-4 h-4 text-sky-300"></i>Spotřeba</span>
					<span class="flex items-center gap-2"><i data-lucide="piggy-bank" class="w-4 h-4 text-sky-300"></i>Rozpočty</span>
					<span class="flex items-center gap-2"><i data-lucide="target" class="w-4 h-4 text-sky-300"></i>Cíle</span>
					<span class="flex items-center gap-2"><i data-lucide="monitor" class="w-4 h-4 text-sky-300"></i>Widget</span>
				</div>
			</div>
		</div>
	</div>
</div>
