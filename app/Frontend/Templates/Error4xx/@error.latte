{* Standalone layout for 4xx pages. Error4xxPresenter lives in the "Error" module, so all links here are absolute (:Frontend:...). *}
<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="robots" content="noindex">
	<title>{include title|stripHtml} · Základna</title>
	{include '../@head.latte'}
	<style>
		@keyframes err-drift { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(4%, 6%); } }
		.err-blob { animation: err-drift 16s ease-in-out infinite; }
		@media (prefers-reduced-motion: reduce) { .err-blob { animation: none; } }
	</style>
</head>
<body class="bg-canvas text-ink font-sans antialiased">
<main class="relative min-h-screen overflow-hidden flex flex-col items-center justify-center px-6 py-16 text-center">
	<div class="err-blob absolute -top-40 left-1/2 -translate-x-1/2 w-[40rem] h-[28rem] rounded-full bg-sky-400/20 blur-3xl pointer-events-none"></div>

	<a n:href=":Frontend:Home:default" class="relative flex items-center gap-2.5 mb-14">
		{include '../@logo.latte'}
		<span class="text-[17px] font-semibold tracking-tight">Základna</span>
	</a>

	<div class="relative rise">
		<div class="text-[7rem] sm:text-[10rem] leading-none font-bold tracking-[-0.06em] num bg-linear-to-b from-ink to-ink/25 bg-clip-text text-transparent select-none">{$httpCode}</div>
		<span class="tile w-14 h-14 rounded-2xl bg-surface text-accent -mt-6 relative" style="box-shadow: var(--shadow-lg)"><i data-lucide="{include icon}" class="w-6! h-6!"></i></span>
		<h1 class="text-3xl sm:text-4xl font-bold tracking-tight mt-6">{include title}</h1>
		<p class="text-lg text-muted mt-3 max-w-md mx-auto">{include text}</p>
		<div class="flex flex-wrap items-center justify-center gap-3 mt-9">
			<a n:href=":Frontend:Home:default" class="btn btn-primary btn-lg"><i data-lucide="house" class="w-4 h-4"></i>Domů</a>
			<button type="button" onclick="history.length > 1 ? history.back() : location.assign('/')" class="btn btn-secondary btn-lg"><i data-lucide="arrow-left" class="w-4 h-4"></i>Zpět</button>
		</div>
		<p class="text-xs text-faint mt-12">Chyba {$httpCode}</p>
	</div>
</main>
</body>
</html>
