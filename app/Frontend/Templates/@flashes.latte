<div n:if="$flashes" class="fixed top-4 inset-x-0 z-[60] flex flex-col items-center gap-2 px-4 pointer-events-none">
	<div n:foreach="$flashes as $flash" x-data="{ show: true }" x-init="setTimeout(() => show = false, 4000)" x-show="show"
		x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:leave="transition ease-in duration-200" x-transition:leave-end="opacity-0 -translate-y-2"
		class="pointer-events-auto glass card flex items-center gap-2.5 pl-3 pr-4 py-2.5 text-sm font-medium" style="box-shadow: var(--shadow-lg)">
		{if $flash->type === 'error'}
			<span class="w-5 h-5 rounded-full bg-neg text-white flex items-center justify-center"><i data-lucide="x" class="w-3.5 h-3.5"></i></span>
		{else}
			<span class="w-5 h-5 rounded-full bg-pos text-white flex items-center justify-center"><i data-lucide="check" class="w-3.5 h-3.5"></i></span>
		{/if}
		{$flash->message}
	</div>
</div>
