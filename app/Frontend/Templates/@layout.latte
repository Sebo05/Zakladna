<!DOCTYPE html>
<html lang="cs" class="scroll-smooth">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{ifset title}{include title|stripHtml} · {/ifset}Základna</title>
	<meta name="description" content="Základna – osobní přehled aut, financí a termínů. STK, pojištění, spotřeba, rozpočty a kalendář na jednom místě.">
	{include '@head.latte'}
</head>

<body class="bg-canvas text-ink font-sans antialiased overflow-x-clip">
{var $bare = $presenter->getName() === 'Frontend:Auth'}

{var $home = $presenter->isLinkCurrent('Home:default')}
<header n:if="!$bare" class="sticky top-0 z-40 glass border-b border-line transition-[background,border-color] duration-300" x-data="{ open: false, top: true }" x-init="top = window.scrollY < 8" @scroll.window.throttle.50ms="top = window.scrollY < 8" data-home="{$home ? 1 : 0}" :class="top && !open && $el.dataset.home === '1' ? 'hdr-top' : ''">
	<div class="max-w-6xl mx-auto px-5 h-14 flex items-center gap-6">
		<a n:href="Home:default" class="flex items-center gap-2.5 shrink-0">
			{include '@logo.latte', size: 'w-7 h-7'}
			<span class="font-semibold tracking-tight">Základna</span>
		</a>

		<nav class="hidden md:flex items-center gap-1 flex-1 text-sm">
			<a n:href="Home:default#funkce" class="px-3 py-1.5 rounded-full text-muted hover:text-ink transition">Funkce</a>
			<a n:href="Home:default#domacnost" class="px-3 py-1.5 rounded-full text-muted hover:text-ink transition">Domácnost</a>
			<a n:href="Home:default#widget" class="px-3 py-1.5 rounded-full text-muted hover:text-ink transition">Widget</a>
			<a n:href="Home:default#faq" class="px-3 py-1.5 rounded-full text-muted hover:text-ink transition">Otázky</a>
			<a n:foreach="$menuItems ?? [] as $item" href="{$item->url}" class="px-3 py-1.5 rounded-full text-muted hover:text-ink transition">{$item->label}</a>
		</nav>

		<div class="flex items-center gap-1 ml-auto">
			<button type="button" onclick="toggleTheme()" class="btn-icon" title="Přepnout režim">
				<i data-lucide="moon" class="w-4 h-4 dark:hidden!"></i><i data-lucide="sun" class="w-4 h-4 hidden! dark:block!"></i>
			</button>
			{if $user->isLoggedIn() && $user->isInRole('admin')}
				<a n:href=":Admin:Dashboard:default" class="btn btn-secondary">Administrace</a>
			{elseif $user->isLoggedIn()}
				<a n:href=":App:Dashboard:default" class="btn btn-primary">Otevřít aplikaci</a>
			{else}
				<a n:href="Auth:login" class="btn btn-ghost hidden sm:inline-flex">Přihlásit</a>
				<a n:href="Auth:register" class="btn btn-primary">Začít zdarma</a>
			{/if}
			<button type="button" @click="open = !open" class="btn-icon md:hidden" title="Menu">
				<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
			</button>
		</div>
	</div>
	<div x-show="open" x-cloak x-transition @click.outside="open = false" class="md:hidden border-t border-line px-5 py-3 space-y-1">
		<a n:href="Home:default#funkce" @click="open = false" class="block px-3 py-2 rounded-xl hover:bg-surface-2">Funkce</a>
		<a n:href="Home:default#domacnost" @click="open = false" class="block px-3 py-2 rounded-xl hover:bg-surface-2">Domácnost</a>
		<a n:href="Home:default#widget" @click="open = false" class="block px-3 py-2 rounded-xl hover:bg-surface-2">Widget</a>
		<a n:href="Home:default#faq" @click="open = false" class="block px-3 py-2 rounded-xl hover:bg-surface-2">Otázky</a>
		<a n:foreach="$menuItems ?? [] as $item" href="{$item->url}" class="block px-3 py-2 rounded-xl hover:bg-surface-2">{$item->label}</a>
		<a n:if="!$user->isLoggedIn()" n:href="Auth:login" class="block px-3 py-2 rounded-xl hover:bg-surface-2">Přihlásit</a>
	</div>
</header>

{include '@flashes.latte'}

{include content}

<footer n:if="!$bare" class="border-t border-line mt-24">
	<div class="max-w-6xl mx-auto px-5 py-14 grid grid-cols-2 md:grid-cols-5 gap-10 text-sm">
		<div class="col-span-2">
			<a n:href="Home:default" class="flex items-center gap-2.5">
				{include '@logo.latte', size: 'w-8 h-8'}
				<span class="text-[17px] font-semibold tracking-tight">Základna</span>
			</a>
			<p class="text-muted mt-4 max-w-xs">Auta, peníze, cíle a domácnost. Na webu, v mobilu i na ploše Windows.</p>
		</div>
		<div>
			<div class="font-semibold mb-3">Produkt</div>
			<ul class="space-y-2 text-muted">
				<li><a n:href="Home:default#funkce" class="hover:text-ink">Funkce</a></li>
				<li><a n:href="Home:default#domacnost" class="hover:text-ink">Domácnost</a></li>
				<li><a n:href="Home:default#widget" class="hover:text-ink">Widget pro Windows</a></li>
			</ul>
		</div>
		<div>
			<div class="font-semibold mb-3">Účet</div>
			<ul class="space-y-2 text-muted">
				<li><a n:href="Auth:register" class="hover:text-ink">Registrace</a></li>
				<li><a n:href="Auth:login" class="hover:text-ink">Přihlášení</a></li>
				<li><a n:href="Home:default#faq" class="hover:text-ink">Časté otázky</a></li>
			</ul>
		</div>
		<div n:if="iterator_count($menuItems ?? [])">
			<div class="font-semibold mb-3">Stránky</div>
			<ul class="space-y-2 text-muted">
				<li n:foreach="$menuItems ?? [] as $item"><a href="{$item->url}" class="hover:text-ink">{$item->label}</a></li>
			</ul>
		</div>
	</div>
	<div class="border-t border-line">
		<div class="max-w-6xl mx-auto px-5 py-6 flex flex-col sm:flex-row justify-between gap-2 text-xs text-faint">
			<span>© {date('Y')} Základna</span>
			<span>Navrženo s péčí. Bez reklam.</span>
		</div>
	</div>
</footer>

</body>
</html>
