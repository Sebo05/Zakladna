<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{ifset title}{include title|stripHtml} · {/ifset}Základna</title>
	{include '../../Frontend/Templates/@head.latte'}
</head>
<body class="bg-canvas text-ink font-sans antialiased">

{define navLink, $dest, $label, $icon}
	<a href="{plink str_replace('*', 'default', $dest)}" n:class="'nav-link', $presenter->isLinkCurrent($dest) ? 'active'">
		<i data-lucide="{$icon}"></i>{$label}
	</a>
{/define}

{define tabLink, $dest, $label, $icon}
	{var $on = $presenter->isLinkCurrent($dest)}
	<a href="{plink str_replace('*', 'default', $dest)}" n:class="'flex flex-col items-center gap-0.5 text-[10px] font-medium py-1 w-16', $on ? 'text-accent' : 'text-muted'">
		<i data-lucide="{$icon}" class="w-6 h-6"></i>{$label}
	</a>
{/define}

<div class="min-h-screen lg:flex">
	{* Sidebar — desktop *}
	<aside class="hidden lg:flex lg:flex-col w-64 shrink-0 h-screen sticky top-0 px-4 py-6 border-r border-line">
		<a n:href=":App:Dashboard:default" class="flex items-center gap-2.5 px-2 mb-6">
			{include '../../Frontend/Templates/@logo.latte'}
			<span class="text-[17px] font-semibold tracking-tight">Základna</span>
		</a>

		<button type="button" @click="$dispatch('open-palette')" x-data class="flex items-center gap-2 w-full px-3 py-2 mb-4 rounded-xl bg-surface-2 text-muted text-sm hover:text-ink transition">
			<i data-lucide="search" class="w-4 h-4"></i>
			<span class="flex-1 text-left">Hledat…</span>
			<span class="kbd">Ctrl K</span>
		</button>

		<nav class="space-y-0.5">
			{include navLink, dest: ':App:Dashboard:default', label: 'Přehled', icon: 'house'}
			{include navLink, dest: ':App:Garage:*', label: 'Garáž', icon: 'car'}
			{include navLink, dest: ':App:Finance:*', label: 'Finance', icon: 'wallet'}
			{include navLink, dest: ':App:Budget:*', label: 'Rozpočty', icon: 'piggy-bank'}
			{include navLink, dest: ':App:Goal:*', label: 'Cíle', icon: 'target'}
			{include navLink, dest: ':App:Household:*', label: 'Domácnost', icon: 'house-plus'}
			{include navLink, dest: ':App:Stats:default', label: 'Statistiky', icon: 'chart-pie'}
			{include navLink, dest: ':App:Calendar:*', label: 'Kalendář', icon: 'calendar'}
		</nav>

		<div class="mt-auto space-y-0.5">
			<button type="button" onclick="toggleTheme()" class="nav-link w-full">
				<i data-lucide="moon" class="dark:hidden!"></i><i data-lucide="sun" class="hidden! dark:block!"></i>
				<span class="dark:hidden">Tmavý režim</span><span class="hidden dark:inline">Světlý režim</span>
			</button>
			<div n:ifset="$currentUser" class="flex items-center gap-3 px-3 py-3 mt-2 rounded-xl bg-surface-2">
				<a n:href=":App:Profile:default" class="flex items-center gap-3 flex-1 min-w-0 group" title="Nastavení profilu">
				<span class="w-8 h-8 rounded-full bg-linear-to-br from-sky-400 to-indigo-500 text-white text-sm font-semibold flex items-center justify-center shrink-0">{$currentUser->name|substr:0,1|upper}</span>
				<div class="min-w-0 flex-1">
					<div class="text-sm font-medium truncate">{$currentUser->name}</div>
					<div class="text-xs text-muted truncate">{$currentUser->email}</div>
				</div>
				</a>
				<a n:href=":Frontend:Auth:logout" class="btn-icon" title="Odhlásit"><i data-lucide="log-out" class="w-4 h-4"></i></a>
			</div>
		</div>
	</aside>

	<div class="flex-1 min-w-0">
		{* Top bar — mobile *}
		<header class="lg:hidden sticky top-0 z-30 glass border-b border-line px-4 h-14 flex items-center justify-between" style="padding-top: env(safe-area-inset-top)">
			<a n:href=":App:Dashboard:default" class="flex items-center gap-2">
				{include '../../Frontend/Templates/@logo.latte', size: 'w-7 h-7'}
				<span class="font-semibold tracking-tight">Základna</span>
			</a>
			<div class="flex items-center gap-1" x-data>
				<button type="button" @click="$dispatch('open-palette')" class="btn-icon" title="Hledat"><i data-lucide="search" class="w-5 h-5"></i></button>
				<button type="button" onclick="toggleTheme()" class="btn-icon" title="Režim"><i data-lucide="moon" class="w-5 h-5 dark:hidden!"></i><i data-lucide="sun" class="w-5 h-5 hidden! dark:block!"></i></button>
				<a n:href=":App:Profile:default" class="btn-icon" title="Profil"><i data-lucide="user" class="w-5 h-5"></i></a>
			</div>
		</header>

		<main class="px-4 sm:px-6 lg:px-10 py-6 lg:py-10 pb-32 lg:pb-12 max-w-6xl mx-auto">
			{include content}
		</main>
	</div>
</div>

{* Tab bar — mobile *}
<nav class="lg:hidden fixed bottom-0 inset-x-0 z-30 glass border-t border-line flex justify-around items-end px-2 pt-1.5" style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom))" x-data>
	{include tabLink, dest: ':App:Dashboard:default', label: 'Přehled', icon: 'house'}
	{include tabLink, dest: ':App:Garage:*', label: 'Garáž', icon: 'car'}
	<button type="button" @click="$dispatch('open-palette')" class="-mt-5 w-14 h-14 rounded-full bg-accent text-white shadow-lg shadow-blue-500/30 flex items-center justify-center active:scale-95 transition" title="Přidat">
		<i data-lucide="plus" class="w-7 h-7"></i>
	</button>
	{include tabLink, dest: ':App:Finance:*', label: 'Finance', icon: 'wallet'}
	{include tabLink, dest: ':App:Calendar:*', label: 'Kalendář', icon: 'calendar'}
</nav>

{include '../../Frontend/Templates/@flashes.latte'}

{* Command palette *}
<script type="application/json" id="palette-actions">{$paletteActions}</script>
<div x-data="palette" data-search="{link :App:Search:default}" x-show="open" x-cloak class="fixed inset-0 z-50 flex items-start justify-center px-4 pt-[12vh]">
	<div class="absolute inset-0 bg-black/30 backdrop-blur-sm" @click="close()" x-show="open" x-transition.opacity></div>
	<div class="relative w-full max-w-xl card overflow-hidden shadow-2xl" style="box-shadow: var(--shadow-lg)" x-show="open"
		x-transition:enter="transition ease-out duration-150" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100">
		<div class="flex items-center gap-3 px-4 border-b border-line">
			<i data-lucide="search" class="w-5 h-5 text-muted"></i>
			<input x-ref="input" x-model="q" @input="onInput()" @keydown.arrow-down.prevent="move(1)" @keydown.arrow-up.prevent="move(-1)" @keydown.enter.prevent="go()"
				type="text" placeholder="Hledej auta, transakce, události… nebo napiš akci" class="flex-1 h-14 bg-transparent outline-none text-[15px] placeholder:text-faint">
			<span class="kbd">Esc</span>
		</div>
		<div x-ref="list" class="max-h-[55vh] overflow-y-auto p-2">
			<template x-for="(it, i) in items" :key="it.url + i">
				<div>
					<div x-show="showGroup(i)" x-text="it.group" class="px-3 pt-3 pb-1 text-xs font-medium text-muted"></div>
					<a :href="it.url" @mouseenter="active = i" :data-active="active === i"
						:class="active === i ? 'bg-accent text-white' : 'text-ink'"
						class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm">
						<span class="w-5 h-5 flex items-center justify-center [&>svg]:w-[18px] [&>svg]:h-[18px]" :class="active === i ? 'text-white' : 'text-muted'" x-html="icon(it.icon)"></span>
						<span class="flex-1 truncate" x-text="it.title"></span>
						<span class="text-xs truncate max-w-[40%]" :class="active === i ? 'text-white/80' : 'text-muted'" x-text="it.subtitle || ''"></span>
					</a>
				</div>
			</template>
			<div x-show="!items.length" class="px-3 py-10 text-center text-sm text-muted">Nic nenalezeno</div>
		</div>
		<div class="hidden sm:flex items-center gap-4 px-4 py-2.5 border-t border-line text-xs text-muted">
			<span class="flex items-center gap-1"><span class="kbd">↑</span><span class="kbd">↓</span> výběr</span>
			<span class="flex items-center gap-1"><span class="kbd">Enter</span> otevřít</span>
		</div>
	</div>
</div>

</body>
</html>
