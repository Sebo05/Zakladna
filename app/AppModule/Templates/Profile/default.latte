{import '../@components.latte'}
{block title}Nastavení profilu{/block}

{block content}
<header class="flex items-center gap-4 mb-8 rise">
	<span class="w-16 h-16 rounded-full bg-linear-to-br from-sky-400 to-indigo-500 text-white text-2xl font-semibold flex items-center justify-center shrink-0">{$currentUser->name|substr:0,1|upper}</span>
	<div class="min-w-0">
		<h1 class="page-title truncate">{$currentUser->name}</h1>
		<p class="page-sub">Členem od {$currentUser->createdAt|date:'j. n. Y'} · {$carsCount} {$carsCount === 1 ? 'auto' : ($carsCount > 1 && $carsCount < 5 ? 'auta' : 'aut')} · {$txCount} transakcí</p>
	</div>
</header>

<div class="max-w-3xl space-y-5">
	{* 1. Personal details *}
	<section class="card p-6 sm:p-8 rise rise-2">
		<div class="flex items-center gap-3 mb-5">
			<span class="tile bg-accent/12 text-accent"><i data-lucide="user"></i></span>
			<h2 class="section-title">Osobní údaje</h2>
		</div>
		{form profileForm, class: 'space-y-4'}
			{include formErrors, form: $form}
			<div class="grid sm:grid-cols-2 gap-4">
				{include field, form: $form, name: 'name'}
				{include field, form: $form, name: 'email'}
			</div>
			{input send, class: 'btn btn-primary'}
		{/form}
	</section>

	{* 2. Password *}
	<section class="card p-6 sm:p-8 rise rise-2" x-data="{ show: false }">
		<div class="flex items-center justify-between gap-3 mb-5">
			<div class="flex items-center gap-3">
				<span class="tile bg-violet-500/12 text-violet-500"><i data-lucide="lock"></i></span>
				<h2 class="section-title">Změna hesla</h2>
			</div>
			<button type="button" @click="show = !show" class="btn btn-ghost text-sm">
				<span x-text="show ? 'Skrýt hesla' : 'Zobrazit hesla'">Zobrazit hesla</span>
			</button>
		</div>
		{form passwordForm, class: 'space-y-4'}
			{include formErrors, form: $form}
			{include field, form: $form, name: 'current'}
			<div class="grid sm:grid-cols-2 gap-4">
				{include field, form: $form, name: 'password', hint: 'Alespoň 8 znaků.'}
				{include field, form: $form, name: 'passwordConfirm'}
			</div>
			{input send, class: 'btn btn-primary'}
		{/form}
	</section>

	{* 3. Appearance — browser only (localStorage 'theme'), same key as toggleTheme() *}
	<section class="card p-6 sm:p-8 rise rise-3"
		x-data="{
			mode: localStorage.getItem('theme') || 'system',
			set(m) {
				this.mode = m;
				if (m === 'system') {
					localStorage.removeItem('theme');
					document.documentElement.classList.toggle('dark', matchMedia('(prefers-color-scheme: dark)').matches);
				} else {
					localStorage.setItem('theme', m);
					document.documentElement.classList.toggle('dark', m === 'dark');
				}
			}
		}">
		<div class="flex items-center gap-3 mb-5">
			<span class="tile bg-amber-500/12 text-amber-500"><i data-lucide="sun"></i></span>
			<h2 class="section-title">Vzhled</h2>
		</div>
		<div class="segmented">
			<button type="button" @click="set('system')" :class="mode === 'system' ? 'on' : ''">Podle systému</button>
			<button type="button" @click="set('light')" :class="mode === 'light' ? 'on' : ''">Světlý</button>
			<button type="button" @click="set('dark')" :class="mode === 'dark' ? 'on' : ''">Tmavý</button>
		</div>
		<p class="text-xs text-muted mt-3">Nastavení se ukládá v tomto prohlížeči.</p>
	</section>

	{* 4. Desktop widget *}
	<section class="card p-6 sm:p-8 rise rise-3">
		<div class="flex items-center gap-3 mb-5">
			<span class="tile bg-sky-500/12 text-sky-500"><i data-lucide="monitor"></i></span>
			<h2 class="section-title">Widget na plochu Windows</h2>
		</div>
		<ol class="space-y-3 text-sm">
			<li class="flex gap-3"><span class="badge badge-muted shrink-0">1</span><span>Ve složce widgetu zkopíruj <code class="px-1.5 py-0.5 rounded-md bg-surface-2">widget.ini.example</code> jako <code class="px-1.5 py-0.5 rounded-md bg-surface-2">widget.ini</code>.</span></li>
			<li class="flex gap-3"><span class="badge badge-muted shrink-0">2</span><span>Vyplň do něj tyto údaje a své heslo (při prvním spuštění se zašifruje):</span></li>
		</ol>
		<div class="mt-4 rounded-xl bg-surface-2 p-4 font-mono text-sm space-y-1 overflow-x-auto">
			<div><span class="text-muted">url=</span>{$baseUrl}</div>
			<div><span class="text-muted">email=</span>{$currentUser->email}</div>
			<div><span class="text-muted">password=</span><span class="text-faint">tvoje-heslo</span></div>
		</div>
		<p class="text-xs text-muted mt-3">Widget čte data z <a n:href="//:Api:Widget:default" class="text-accent break-all">{link //:Api:Widget:default}</a>.</p>
	</section>

	{* 5. Export *}
	<section class="card p-6 sm:p-8 rise rise-4">
		<div class="flex items-center gap-3 mb-3">
			<span class="tile bg-pos/12 text-pos"><i data-lucide="download"></i></span>
			<h2 class="section-title">Export dat</h2>
		</div>
		<p class="text-sm text-muted mb-5">Všechny transakce jako CSV, otevřeš v Excelu nebo Google Tabulkách.</p>
		<a n:href="export" class="btn btn-secondary"><i data-lucide="file-text" class="w-4 h-4"></i>Stáhnout transakce (CSV)</a>
	</section>

	{* 6. Danger zone *}
	<section class="card p-6 sm:p-8 rise rise-4 ring-1 ring-neg/25" data-open="{$presenter['deleteForm']->hasErrors() ? 1 : 0}" x-data="{ open: $el.dataset.open === '1' }">
		<div class="flex items-center gap-3 mb-3">
			<span class="tile bg-neg/12 text-neg"><i data-lucide="circle-alert"></i></span>
			<h2 class="section-title">Nebezpečná zóna</h2>
		</div>
		<p class="text-sm text-muted">Smazání účtu odstraní auta, transakce, rozpočty, cíle a události. Z domácnosti odejdeš. Nejde to vrátit.</p>
		<button type="button" x-show="!open" @click="open = true" class="btn btn-danger mt-5"><i data-lucide="trash-2" class="w-4 h-4"></i>Smazat účet</button>
		<div x-show="open" x-cloak class="mt-5">
			{form deleteForm, class: 'space-y-4'}
				{include formErrors, form: $form}
				<div class="grid sm:grid-cols-2 gap-4">
					{include field, form: $form, name: 'confirmEmail', hint: $currentUser->email}
					{include field, form: $form, name: 'password'}
				</div>
				<div class="flex gap-2">
					{input send, class: 'btn btn-danger'}
					<button type="button" @click="open = false" class="btn btn-secondary">Zrušit</button>
				</div>
			{/form}
		</div>
	</section>
</div>
{/block}
