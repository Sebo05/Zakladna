{import '../@components.latte'}
{block title}Upravit tankování{/block}
{block content}
{include formHeader, title: 'Upravit tankování', back: $presenter->link('Garage:detail', $car->id), backLabel: $car->name}
<div class="card p-6 sm:p-8 max-w-2xl rise rise-2">{include _form.latte}</div>
<div class="max-w-2xl mt-6 text-center"><a n:href="delete $record->id" data-confirm="Smazat tankování (i související výdaj)?" class="btn btn-danger"><i data-lucide="trash-2" class="w-4 h-4"></i>Smazat tankování</a></div>
{/block}
